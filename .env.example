EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# RevenueCat public SDK key. Use a test_... (sandbox) key in development, swap to
# the production key at ship time — no code change needed either way.
EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-public-api-key
# Optional: only needed once you have separate production keys per platform (most
# apps only get these when they actually ship both stores). When both are set they
# take priority over the shared key above; unset, the shared key covers both.
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your-ios-public-api-key
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your-android-public-api-key
